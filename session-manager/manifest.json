{
  "manifest_version": 3,
  "name": "Session Manager Pro",
  "version": "1.0.0",
  "description": "Professional tab session manager with tree view, auto-save, and import/export.",
  "permissions": [
    "tabs",
    "tabGroups",
    "storage",
    "sessions",
    "bookmarks",
    "activeTab"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.svg",
      "32": "icons/icon32.svg",
      "48": "icons/icon48.svg",
      "128": "icons/icon128.svg"
    }
  },
  "icons": {
    "16": "icons/icon16.svg",
    "32": "icons/icon32.svg",
    "48": "icons/icon48.svg",
    "128": "icons/icon128.svg"
  },
  "background": {
    "service_worker": "background.js"
  },
  "minimum_chrome_version": "116"
}
