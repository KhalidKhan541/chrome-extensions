{
  "manifest_version": 3,
  "name": "Text Counter",
  "version": "1.0.0",
  "description": "Comprehensive text statistics tool - count characters, words, sentences, and more",
  "permissions": [
    "activeTab",
    "storage",
    "scripting"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.svg",
      "32": "icons/icon32.svg",
      "48": "icons/icon48.svg",
      "128": "icons/icon128.svg"
    }
  },
  "icons": {
    "16": "icons/icon16.svg",
    "32": "icons/icon32.svg",
    "48": "icons/icon48.svg",
    "128": "icons/icon128.svg",
    "256": "icons/icon256.svg"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["text-analyzer.js", "frequency-analyzer.js"],
      "run_at": "document_end"
    }
  ]
}
