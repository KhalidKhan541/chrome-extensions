{
  "manifest_version": 3,
  "name": "Color Palette Generator",
  "description": "Extract colors from images and generate harmonious color palettes. Export as CSS, Tailwind, SCSS, or JSON.",
  "version": "1.0.0",
  "permissions": ["activeTab", "storage", "tabs", "scripting"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Color Palette Generator"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "context_menus": [
    {
      "id": "extract-colors",
      "title": "Extract Colors from Image",
      "contexts": ["image"]
    }
  ]
}
