{
  "manifest_version": 3,
  "name": "Form AutoFill",
  "version": "1.0.0",
  "description": "Smart form filling tool with multiple profiles",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "tabs"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.svg",
      "32": "icons/icon32.svg",
      "48": "icons/icon48.svg",
      "128": "icons/icon128.svg"
    }
  },
  "icons": {
    "16": "icons/icon16.svg",
    "32": "icons/icon32.svg",
    "48": "icons/icon48.svg",
    "128": "icons/icon128.svg"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["autofill-engine.js", "content.js"],
      "css": [],
      "run_at": "document_idle"
    }
  ],
  "context_menus": [
    {
      "id": "autofill-form",
      "title": "AutoFill Form",
      "contexts": ["all"]
    }
  ]
}
