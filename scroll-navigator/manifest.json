{
  "manifest_version": 3,
  "name": "Scroll Navigator",
  "version": "1.0.0",
  "description": "Scroll control and navigation enhancement tool with smooth scrolling, speed control, and position memory.",
  "permissions": [
    "activeTab",
    "storage",
    "tabs"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.svg",
      "32": "icons/icon32.svg",
      "48": "icons/icon48.svg",
      "128": "icons/icon128.svg"
    }
  },
  "icons": {
    "16": "icons/icon16.svg",
    "32": "icons/icon32.svg",
    "48": "icons/icon48.svg",
    "128": "icons/icon128.svg"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["scroll-engine.js", "keyboard-shortcuts.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "scroll-to-top": {
      "suggested_key": {
        "default": "Ctrl+Shift+Up",
        "mac": "Command+Shift+Up"
      },
      "description": "Scroll to top"
    },
    "scroll-to-bottom": {
      "suggested_key": {
        "default": "Ctrl+Shift+Down",
        "mac": "Command+Shift+Down"
      },
      "description": "Scroll to bottom"
    },
    "page-up": {
      "suggested_key": {
        "default": "Alt+Up",
        "mac": "Option+Up"
      },
      "description": "Page up"
    },
    "page-down": {
      "suggested_key": {
        "default": "Alt+Down",
        "mac": "Option+Down"
      },
      "description": "Page down"
    },
    "toggle-autoscroll": {
      "suggested_key": {
        "default": "Alt+A"
      },
      "description": "Toggle auto-scroll"
    }
  }
}
